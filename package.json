{
  "name": "2a-prints-accounting",
  "version": "2.0.6",
  "description": "2A Prints Accounting - Desktop App",
  "main": "main.js",
  "author": "2A Prints",
  "private": true,
  "scripts": {
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.kingzizou.2aprintsaccounting",
    "productName": "2A Prints Accounting",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "executableName": "2a-prints-accounting",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kingzizou",
        "repo": "2A-Accounting-releases"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3"
  }
}